# Data files are reproducible via scripts/download_data.py and are not
# committed. The data/README.md documents every series.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Generated outputs (figures/tables are regenerated by the pipeline).
# Final paper figures are committed under paper/figures once selected.
outputs/figures/*
outputs/tables/*
outputs/models/*
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep
!outputs/models/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# LaTeX build artifacts
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
